{
  "name": "@gwro/codeaside",
  "version": "0.3.3",
  "description": "Drive your Claude Code sessions from Even Realities G2 smart glasses, natively on Windows: live transcript, approvals, and hold-to-talk voice.",
  "type": "module",
  "bin": {
    "codeaside": "bin/codeaside"
  },
  "files": [
    "bin/codeaside",
    "bin/codeaside-hook.mjs",
    "host/",
    "hub/",
    "app/dist/",
    "docs/privacy.md",
    "docs/windows-design.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && npm test --prefix app",
    "test:hub": "node --test test/*.test.mjs",
    "build:app": "npm ci --prefix app && npm run build --prefix app",
    "pack:app": "npm run pack:store --prefix app",
    "prepack": "npm run build:app",
    "pack:personal": "npm run pack --prefix app"
  },
  "keywords": [
    "claude-code",
    "even-realities",
    "g2",
    "smart-glasses",
    "windows",
    "conpty",
    "even-hub"
  ],
  "license": "MIT",
  "author": "Grzegorz Wrobel",
  "homepage": "https://github.com/gwro/CodeAside#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gwro/CodeAside.git"
  },
  "bugs": {
    "url": "https://github.com/gwro/CodeAside/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "qrcode-terminal": "^0.12.0"
  }
}
